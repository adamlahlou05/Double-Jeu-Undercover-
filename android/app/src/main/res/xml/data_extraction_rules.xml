<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 et plus. Rien ne part dans la sauvegarde Google (les photos des joueurs restent sur le
     téléphone, et une réinstallation repart de zéro). Le transfert direct vers un nouveau téléphone,
     de câble à câble, reste possible. Les achats, eux, sont retrouvés par Google Play. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
