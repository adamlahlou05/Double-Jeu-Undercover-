<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde Android et transfert vers un nouveau téléphone (Android 12+) : joueurs, scores et historique. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
